# Byte-compiled / optimized / DLL files
__pycache__/
*.py[codz]
*$py.class
*.pyc

# C extensions
*.so

# Environments
.env
.env.*
.venv
env/
venv/
ENV/

# Jupyter Notebook
.ipynb_checkpoints/

# Models & Weights
models/*.pt
models/*.pth
models/*.onnx
models/*.h5

# Data directory contents (excluding .gitkeep)
data/raw/*
data/processed/*
data/external/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep
!models/.gitkeep
!notebooks/.gitkeep
!reports/.gitkeep
!tests/.gitkeep
!src/*/.gitkeep

# Logs
*.log

# Unit test / coverage reports
htmlcov/
.pytest_cache/

# OS / Editor specific
.DS_Store
Thumbs.db
.vscode/
.idea/
